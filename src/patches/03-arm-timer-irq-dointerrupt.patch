+    cpu->gt_cntfrq_hz = 19200000;
+    /* Unicorn engine: host-driven IRQ/timer lines start clear, delivery on. */
+    cpu->uc_cntpct = 0;
+    cpu->uc_ext_irq = 0;
+    cpu->uc_gt_irq[0] = cpu->uc_gt_irq[1] = 0;
+    cpu->uc_gt_irq[2] = cpu->uc_gt_irq[3] = 0;
+    cpu->uc_deliver_exceptions = true;
+
     arm_rebuild_hflags(env);
 
     return cpu;
