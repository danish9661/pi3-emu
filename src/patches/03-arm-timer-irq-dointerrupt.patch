+/* Unicorn engine: OR the host-driven external line and the generic-timer
+ * lines into CPU_INTERRUPT_HARD in real time (no QEMUTimers in this build).
+ * Skipped while delivery is disabled; line levels are still tracked. */
+void arm_cpu_update_uc_irq(ARMCPU *cpu)
 {
-    ARMCPUClass *acc = ARM_CPU_CLASS(oc);
+    CPUState *cs = CPU(cpu);
+    int i, level;
+
+    if (!cpu->uc_deliver_exceptions) {
+        return;
+    }
+    level = cpu->uc_ext_irq;
+    for (i = 0; i < 4; i++) {
+        level |= cpu->uc_gt_irq[i];
+    }
+    if (level) {
+        cpu_interrupt(cs, CPU_INTERRUPT_HARD);
+    } else {
+        cpu_reset_interrupt(cs, CPU_INTERRUPT_HARD);
+    }
+}
