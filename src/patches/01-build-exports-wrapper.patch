+        // Unicorn engine host extensions (AArch64 only, see unicorn.h).
+        // arm64_debug returns a BigInt (uint64_t) — Number() it to compare.
+        // arm64_timer_tick takes a BigInt cntpct for the same reason.
+        this.arm64_debug = function (sel) {
+            var handle = Module.getValue(this.handle_ptr, '*');
+            return Module.ccall('uc_arm64_debug', 'bigint', ['number', 'number'], [handle, sel]);
+        }
+
+        this.arm64_set_irq = function (level) {
+            var handle = Module.getValue(this.handle_ptr, '*');
+            return Module.ccall('uc_arm64_set_irq', 'number', ['number', 'number'], [handle, level]);
+        }
+
+        this.arm64_timer_tick = function (cntpct) {
+            var handle = Module.getValue(this.handle_ptr, '*');
+            // Coerce: newer emscripten ccall rejects Number for bigint args,
+            // older coerced silently. Accept both (callers pass either).
+            return Module.ccall('uc_arm64_timer_tick', 'number', ['number', 'bigint'], [handle, BigInt(cntpct)]);
+        }
+
+        this.arm64_deliver_exceptions = function (enable) {
+            var handle = Module.getValue(this.handle_ptr, '*');
+            return Module.ccall('uc_arm64_deliver_exceptions', 'number', ['number', 'number'], [handle, enable]);
+        }
+
