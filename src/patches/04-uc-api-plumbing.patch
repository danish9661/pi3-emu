+/* Unicorn engine host APIs (see unicorn/unicorn.h). The first CPU owns the
+ * shared lines; secondaries in the smp demo never use timers or IRQs. */
+
+void arm64_set_irq(struct uc_struct *uc, int level)
+{
+    ARMCPU *cpu = ARM_CPU(uc->cpu);
+
+    cpu->uc_ext_irq = level ? 1 : 0;
+    arm_cpu_update_uc_irq(cpu);
+}
+
+void arm64_timer_tick(struct uc_struct *uc, uint64_t cntpct)
+{
+    ARMCPU *cpu = ARM_CPU(uc->cpu);
+    int i;
+
+    cpu->uc_cntpct = cntpct;
+    /* Re-evaluate every generic-timer compare against the new counter. */
+    for (i = 0; i < 4; i++) {
+        gt_recalc_timer(cpu, i);
+    }
+}
+
+uint64_t arm64_debug(struct uc_struct *uc, int sel)
+{
+    ARMCPU *cpu = ARM_CPU(uc->cpu);
+    CPUARMState *env = &cpu->env;
+    CPUState *cs = CPU(cpu);
+
+    switch (sel) {
+    case 0:
+        return cs->interrupt_request;
+    case 1:
+        return env->daif;
+    case 2:
+        return (uint64_t)cpu->uc_ext_irq;
+    case 3:
+        return (uint64_t)cpu->uc_gt_irq[0]; /* CNTPNS */
+    case 4:
+        return cpu->uc_cntpct;
+    case 5:
+        return env->pc;
+    case 6:
+        return (uint64_t)cs->exception_index;
+    case 7:
+        return env->cp15.esr_el[1];
+    case 11:
+        return (uint64_t)cpu->uc_gt_irq[1]; /* CNTV */
+    case 12:
+        return (uint64_t)cpu->uc_gt_irq[2]; /* CNTHP */
+    case 13:
+        return (uint64_t)cpu->uc_gt_irq[3]; /* CNTPS */
+    case 70:
+        return env->cp15.far_el[1];
+    case 71:
+        return env->cp15.sctlr_el[1];
+    case 72:
+        return env->cp15.hcr_el2;
+    default:
+        /* Diagnostic selectors of earlier instrumented builds intentionally
+         * return 0 (per-walk rings cost ~3000x throughput). */
+        return 0;
+    }
+}
+
+void arm64_deliver_exceptions(struct uc_struct *uc, int enable)
+{
+    ARMCPU *cpu = ARM_CPU(uc->cpu);
+
+    cpu->uc_deliver_exceptions = enable ? true : false;
+    arm_cpu_update_uc_irq(cpu);
+}
