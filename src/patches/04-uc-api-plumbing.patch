+/*
+ Assert/de-assert the host-driven external IRQ line (AArch64 only).
+ Level-triggered: the line stays asserted until cleared or the guest
+ masks the source; see arm_cpu_update_uc_irq().
+ NOTE: UC_INIT() returns a value, so void entry points repeat its body.
+*/
+UNICORN_EXPORT
+void uc_arm64_set_irq(uc_engine *uc, int level)
+{
+    save_jit_state(uc);
+    if (unlikely(!uc->init_done)) {
+        if (unlikely(uc_init_engine(uc) != UC_ERR_OK)) {
+            return;
+        }
+    }
+    uc->arm64_set_irq(uc, level);
+}
+
+/*
+ Advance the ARM generic-timer counter (AArch64 only). Re-evaluates all
+ timer compares at the real Pi 3 CNTFRQ (19.2 MHz) rate.
+*/
+UNICORN_EXPORT
+void uc_arm64_timer_tick(uc_engine *uc, uint64_t cntpct)
+{
+    save_jit_state(uc);
+    if (unlikely(!uc->init_done)) {
+        if (unlikely(uc_init_engine(uc) != UC_ERR_OK)) {
+            return;
+        }
+    }
+    uc->arm64_timer_tick(uc, cntpct);
+}
+
+/*
+ Host debug reads (AArch64 only). Selectors: 0 interrupt_request, 1 daif,
+ 2 ext-irq line, 3/11/12/13 generic-timer lines (CNTPNS/CNTV/CNTHP/CNTPS),
+ 4 counter, 5 pc, 6 exception_index, 7 ESR_EL1, 70 FAR_EL1, 71 SCTLR_EL1,
+ 72 HCR_EL2. Others return 0.
+*/
+UNICORN_EXPORT
+uint64_t uc_arm64_debug(uc_engine *uc, int sel)
+{
+    UC_INIT(uc);
+    return uc->arm64_debug(uc, sel);
+}
+
+/*
+ Gate real exception delivery (AArch64 only). Enabled by default; disable
+ to track IRQ lines without entering vectors (host-assisted delivery).
+*/
+UNICORN_EXPORT
+void uc_arm64_deliver_exceptions(uc_engine *uc, int enable)
+{
+    save_jit_state(uc);
+    if (unlikely(!uc->init_done)) {
+        if (unlikely(uc_init_engine(uc) != UC_ERR_OK)) {
+            return;
+        }
+    }
+    uc->arm64_deliver_exceptions(uc, enable);
+}
+
